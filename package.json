{
  "name": "groupez-documentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "prepare:api": "node scripts/prepare-api.mjs",
    "postinstall": "npm run prepare:content && fumadocs-mdx && npm run prepare:api",
    "dev": "npm run postinstall && next dev",
    "build": "npm run postinstall && next build",
    "start": "node server.cjs",
    "typecheck": "npm run postinstall && next typegen && tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:server": "node scripts/test-server.mjs",
    "test:discord": "node scripts/test-discord.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
